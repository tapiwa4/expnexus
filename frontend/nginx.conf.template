server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # BACKEND_ORIGIN is set as a Container App env var and filled in here at container
    # startup by nginx's built-in envsubst-on-templates entrypoint — no rebuild needed
    # if the backend's URL changes.
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media/ {
        proxy_pass ${BACKEND_ORIGIN}/media/;
    }

    # SPA fallback so direct navigation to e.g. /security-scan/email works.
    location / {
        try_files $uri /index.html;
    }
}
