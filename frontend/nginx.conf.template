server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # BACKEND_ORIGIN is set as a Container App env var and filled in here at container
    # startup by nginx's built-in envsubst-on-templates entrypoint — no rebuild needed
    # if the backend's URL changes.
    #
    # proxy_ssl_server_name/proxy_ssl_name + Host=$proxy_host are required here: Azure
    # Container Apps environments host multiple apps behind one shared ingress IP and
    # route by TLS SNI, then by Host header. Without explicitly sending the backend's
    # own hostname as SNI, the shared ingress can't tell which app we want and resets
    # the connection mid-handshake (seen as "peer closed connection in SSL handshake").
    # proxy_http_version 1.1 + clearing Connection is required too: nginx defaults to
    # speaking HTTP/1.0 to proxied upstreams, and Azure's edge for the backend app
    # rejects that with 426 Upgrade Required.
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN}/api/;
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media/ {
        proxy_pass ${BACKEND_ORIGIN}/media/;
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $proxy_host;
    }

    # Each known route has its own prerendered index.html (see scripts/prerender.mjs) —
    # $uri/index.html serves that real content to crawlers. Anything else (e.g. an
    # unknown client-side route) falls back to the root SPA shell.
    location / {
        try_files $uri $uri/index.html /index.html;
    }
}
